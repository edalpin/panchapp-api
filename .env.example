# General
PORT=3000
NODE_ENV=development

# Database
# Matches credentials in docker-compose.yml
DATABASE_URL=postgresql://user:pass@localhost:5433/panchapp

# Logging
LOG_LEVEL=info

# GraphQL
GRAPHQL_GRAPHIQL=true

# CORS — omit to allow all origins (dev-friendly for React Native)
# CORS_ORIGIN=http://localhost:8081
