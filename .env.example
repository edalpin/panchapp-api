# General
PORT=3000
NODE_ENV=development

# Database
# Matches credentials in docker-compose.yml
DATABASE_URL=postgresql://user:pass@localhost:5433/panchapp

# Logging
LOG_LEVEL=info

# GraphQL
GRAPHQL_GRAPHIQL=true

# CORS
# In development, omit CORS_ORIGIN to allow all origins
# CORS_ORIGIN=http://localhost:5173

# Auth
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_MS=86400000
JWT_REFRESH_EXPIRES_MS=1296000000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cookies
# For cross-site Railway deploys use COOKIE_SAME_SITE=none and COOKIE_SECURE=true
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none

# Proxy
# Enable when deployed behind TLS termination (e.g. Railway)
# TRUST_PROXY=true

# Admin
ADMIN_API_KEY=change-me-to-a-random-string-at-least-32-chars
