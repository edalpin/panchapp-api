# General
PORT=3000
NODE_ENV=development

# Database
# Matches credentials in docker-compose.yml
DATABASE_URL=postgresql://user:pass@localhost:5433/panchapp

# Logging
LOG_LEVEL=info

# GraphQL
GRAPHQL_GRAPHIQL=true

# CORS — omit to allow all origins (dev-friendly for React Native)
# CORS_ORIGIN=http://localhost:8081

# Auth
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Admin — ops REST endpoints (POST /admin/*)
ADMIN_API_KEY=change-me-to-a-random-string-at-least-32-chars
